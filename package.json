{
  "name": "opencode-notify",
  "version": "0.1.0",
  "description": "Sistema de notificaciones para OpenCode: toast del sistema, sonido, flash de título y bell.",
  "type": "module",
  "main": "src/infrastructure/plugin.ts",
  "exports": {
    ".": "./src/infrastructure/plugin.ts"
  },
  "files": [
    "src",
    "notify.example.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsc -p tsconfig.verify.json && node .verify-dist/test/verify.js"
  },
  "keywords": [
    "opencode",
    "plugin",
    "notify",
    "notification"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.11",
    "@opencode-ai/sdk": "^1.18.11",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.6.0"
  }
}
